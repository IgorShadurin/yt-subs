{
  "manifest_version": 3,
  "name": "YT Subs Studio",
  "version": "1.1.0",
  "description": "Send your exact YouTube Studio subscriber count to the local YT Subs macOS app.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT Subs Studio",
    "default_popup": "popup.html"
  }
}
